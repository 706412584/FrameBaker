{
  "name": "framebaker",
  "version": "0.4.0",
  "description": "像素风逐帧动画编辑器（Bun 全栈 monorepo）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/server/src/index.ts",
    "start": "bun apps/server/src/index.ts",
    "desktop:dev": "electron desktop/main.cjs",
    "check:animation": "bun scripts/check_animation.ts && bun scripts/check_animation_package.ts",
    "typecheck": "tsc -p apps/server && tsc -p apps/web",
    "test": "bun test tests",
    "test:coverage": "bun test tests --coverage --coverage-reporter=text",
    "package:win": "bun scripts/package-windows.ts",
    "version:check": "bun scripts/version.ts check",
    "version:plan": "bun scripts/version.ts plan",
    "version:bump": "bun scripts/version.ts bump"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "bun-types": "^1.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "io.github.framebaker",
    "productName": "FrameBaker",
    "directories": {
      "buildResources": "build",
      "output": "release/desktop"
    },
    "files": [
      "desktop/**/*",
      "build/installer-icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "release/framebaker-win/FrameBaker-server.exe",
        "to": "FrameBaker-server.exe"
      },
      {
        "from": "release/framebaker-win/resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "build/installer-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FrameBaker",
      "include": "build/installer.nsh"
    }
  }
}
