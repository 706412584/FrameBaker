{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framebaker:schema:fbanim:manifest:1",
  "type": "object",
  "required": ["format", "packageVersion", "createdBy", "assets"],
  "properties": {
    "format": { "const": "framebaker-animation-package" },
    "packageVersion": { "const": 1 },
    "createdBy": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "maxItems": 1023,
      "items": {
        "type": "object",
        "required": ["kind", "id", "schemaVersion", "path", "byteLength", "digest", "dependencies"],
        "properties": {
          "kind": { "enum": ["skeleton", "motion-clip"] },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "schemaVersion": { "const": 1 },
          "path": { "type": "string", "pattern": "^(skeletons|motions)/[a-f0-9]{64}\\.json$", "maxLength": 160 },
          "byteLength": { "type": "integer", "minimum": 0, "maximum": 33554432 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "id"],
              "properties": {
                "kind": { "enum": ["skeleton", "motion-clip"] },
                "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "skeleton" } } },
            "then": { "properties": { "dependencies": { "type": "array", "maxItems": 0 }, "path": { "type": "string", "pattern": "^skeletons/" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "motion-clip" } } },
            "then": {
              "properties": {
                "dependencies": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": { "type": "object", "properties": { "kind": { "const": "skeleton" } } }
                },
                "path": { "type": "string", "pattern": "^motions/" }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*)+$" }
    }
  },
  "additionalProperties": false
}
