{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framebaker:schema:animation:render-profile:1",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "name", "width", "height", "fps", "origin", "scale", "background"],
  "properties": {
    "schemaVersion": { "const": 1 }, "kind": { "const": "render-profile" },
    "id": { "$ref": "urn:framebaker:schema:animation:common:1#/$defs/id" },
    "name": { "$ref": "urn:framebaker:schema:animation:common:1#/$defs/name" },
    "extensions": { "$ref": "urn:framebaker:schema:animation:common:1#/$defs/extensions" },
    "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "fps": { "type": "number", "minimum": 1, "maximum": 120 },
    "origin": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "number" }, { "type": "number" }], "items": false },
    "scale": { "type": "number", "exclusiveMinimum": 0 }, "background": { "const": "transparent" }
  },
  "additionalProperties": false
}
